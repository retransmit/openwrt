/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "ipq9574.dtsi"

/ {
	model = "JioRouter AX6000 JIDU6J11";
	compatible = "jiorouter,ax6000-jidu6j11", "qcom,ipq9574";

	aliases {
		serial0 = &blsp1_uart2;
		led-boot = &led_red;
		led-failsafe = &led_red;
		led-running = &led_green;
		led-upgrade = &led_blue;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&keys_pins>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 10 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_red: led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_green: led-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_blue: led-2 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/*
	 * The board has no adjustable CPU regulator in use. The vendor
	 * firmware runs the CPU rail at a fixed 1.075 V.
	 */
	regulator_cpu: regulator-cpu {
		compatible = "regulator-fixed";
		regulator-name = "cpu-vdd";
		regulator-min-microvolt = <1075000>;
		regulator-max-microvolt = <1075000>;
		regulator-boot-on;
		regulator-always-on;
	};

	regulator_fixed_3p3: regulator-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "fixed_3p3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	regulator_fixed_0p925: regulator-0p925 {
		compatible = "regulator-fixed";
		regulator-name = "fixed_0p925";
		regulator-min-microvolt = <925000>;
		regulator-max-microvolt = <925000>;
		regulator-boot-on;
		regulator-always-on;
	};

	regulator_usb_phy: regulator-usb-phy {
		compatible = "regulator-fixed";
		regulator-name = "vdd_usb_phy";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&regulator_fixed_3p3>;
	};
};

&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&cpu0 {
	cpu-supply = <&regulator_cpu>;
};

&cpu1 {
	cpu-supply = <&regulator_cpu>;
};

&cpu2 {
	cpu-supply = <&regulator_cpu>;
};

&cpu3 {
	cpu-supply = <&regulator_cpu>;
};

&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
	status = "okay";

	ethernet-phy-package@10 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x10>;

		qca8075_0: ethernet-phy@10 {
			reg = <0x10>;
		};

		qca8075_1: ethernet-phy@11 {
			reg = <0x11>;
		};

		qca8075_2: ethernet-phy@12 {
			reg = <0x12>;
		};

		qca8075_3: ethernet-phy@13 {
			reg = <0x13>;
		};

		qca8075_4: ethernet-phy@14 {
			reg = <0x14>;
		};
	};
};

&pcie1_phy {
	status = "okay";
};

/* QCN9074 5 GHz radio */
&pcie1 {
	pinctrl-0 = <&pcie1_pins>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "pci17cb,1104";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			qcom,ath11k-fw-memory-mode = <2>;
			qcom,ath11k-calibration-variant = "JIDU6J11";
			nvmem-cells = <&base_mac 3>, <&cal_5g>;
			nvmem-cell-names = "mac-address", "calibration";
		};
	};
};

/*
 * The fifth QCA8075 port needs a fifth PCS channel on the first UNIPHY.
 * The SoC dtsi only describes four.
 */
&pcs0 {
	pcs0_ch4: pcs-mii@4 {
		reg = <4>;
		clocks = <&nsscc NSS_CC_UNIPHY_PORT5_RX_CLK>,
			 <&nsscc NSS_CC_UNIPHY_PORT5_TX_CLK>;
		clock-names = "rx",
			      "tx";
	};
};

&qcom_ppe {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		wan: port@1 {
			reg = <1>;
			label = "wan";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_0>;
			pcs-handle = <&pcs0_ch0>;
			nvmem-cells = <&base_mac 0>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		lan1: port@2 {
			reg = <2>;
			label = "lan1";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_1>;
			pcs-handle = <&pcs0_ch1>;
			nvmem-cells = <&base_mac 1>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		lan2: port@3 {
			reg = <3>;
			label = "lan2";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_2>;
			pcs-handle = <&pcs0_ch2>;
			nvmem-cells = <&base_mac 1>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT3_MAC_CLK>,
				 <&nsscc NSS_CC_PORT3_RX_CLK>,
				 <&nsscc NSS_CC_PORT3_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT3_MAC_ARES>,
				 <&nsscc PORT3_RX_ARES>,
				 <&nsscc PORT3_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		lan3: port@4 {
			reg = <4>;
			label = "lan3";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_3>;
			pcs-handle = <&pcs0_ch3>;
			nvmem-cells = <&base_mac 1>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT4_MAC_CLK>,
				 <&nsscc NSS_CC_PORT4_RX_CLK>,
				 <&nsscc NSS_CC_PORT4_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT4_MAC_ARES>,
				 <&nsscc PORT4_RX_ARES>,
				 <&nsscc PORT4_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		lan4: port@5 {
			reg = <5>;
			label = "lan4";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_4>;
			pcs-handle = <&pcs0_ch4>;
			nvmem-cells = <&base_mac 1>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT5_MAC_CLK>,
				 <&nsscc NSS_CC_PORT5_RX_CLK>,
				 <&nsscc NSS_CC_PORT5_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT5_MAC_ARES>,
				 <&nsscc PORT5_RX_ARES>,
				 <&nsscc PORT5_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_snand_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-engine = <&qpic_nand>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x180000>;
				read-only;
			};

			partition@180000 {
				label = "0:SBL1_1";
				reg = <0x180000 0x180000>;
				read-only;
			};

			partition@300000 {
				label = "0:MIBIB";
				reg = <0x300000 0x100000>;
				read-only;
			};

			partition@400000 {
				label = "0:BOOTCONFIG";
				reg = <0x400000 0x80000>;
				read-only;
			};

			partition@480000 {
				label = "0:BOOTCONFIG1";
				reg = <0x480000 0x80000>;
				read-only;
			};

			partition@500000 {
				label = "0:QSEE";
				reg = <0x500000 0x380000>;
				read-only;
			};

			partition@880000 {
				label = "0:QSEE_1";
				reg = <0x880000 0x380000>;
				read-only;
			};

			partition@c00000 {
				label = "0:DEVCFG_1";
				reg = <0xc00000 0x80000>;
				read-only;
			};

			partition@c80000 {
				label = "0:DEVCFG";
				reg = <0xc80000 0x80000>;
				read-only;
			};

			partition@d00000 {
				label = "0:APDP_1";
				reg = <0xd00000 0x80000>;
				read-only;
			};

			partition@d80000 {
				label = "0:APDP";
				reg = <0xd80000 0x80000>;
				read-only;
			};

			partition@e00000 {
				label = "0:TME";
				reg = <0xe00000 0x80000>;
				read-only;
			};

			partition@e80000 {
				label = "0:TME_1";
				reg = <0xe80000 0x80000>;
				read-only;
			};

			partition@f00000 {
				label = "0:RPM_1";
				reg = <0xf00000 0x80000>;
				read-only;
			};

			partition@f80000 {
				label = "0:RPM";
				reg = <0xf80000 0x80000>;
				read-only;
			};

			partition@1000000 {
				label = "0:CDT_1";
				reg = <0x1000000 0x80000>;
				read-only;
			};

			partition@1080000 {
				label = "0:CDT";
				reg = <0x1080000 0x80000>;
				read-only;
			};

			partition@1100000 {
				label = "0:APPSBLENV";
				reg = <0x1100000 0x80000>;
			};

			partition@1180000 {
				label = "0:APPSBL_1";
				reg = <0x1180000 0x180000>;
				read-only;
			};

			partition@1300000 {
				label = "0:APPSBL";
				reg = <0x1300000 0x180000>;
				read-only;
			};

			partition@1480000 {
				label = "0:ART";
				reg = <0x1480000 0x100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					base_mac: base-mac@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					cal_2g: calibration@1000 {
						reg = <0x1000 0x20000>;
					};

					cal_5g: calibration@4c000 {
						reg = <0x4c000 0x20000>;
					};
				};
			};

			partition@1580000 {
				label = "0:ETHPHYFW";
				reg = <0x1580000 0x100000>;
				read-only;
			};

			partition@1680000 {
				label = "0:TRAINING";
				reg = <0x1680000 0x80000>;
				read-only;
			};

			partition@1700000 {
				label = "ubi";
				reg = <0x1700000 0xe100000>;
			};

			partition@f800000 {
				label = "Jio-Reserved";
				reg = <0xf800000 0x200000>;
				read-only;
			};

			partition@fa00000 {
				label = "MFG";
				reg = <0xfa00000 0x200000>;
				read-only;
			};

			partition@fc00000 {
				label = "0:BDF";
				reg = <0xfc00000 0x200000>;
				read-only;
			};
		};
	};
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&tlmm {
	keys_pins: keys-state {
		pins = "gpio10";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio6", "gpio16", "gpio17";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	mdio_pins: mdio-state {
		mdc-pins {
			pins = "gpio38";
			function = "mdc";
			drive-strength = <8>;
			bias-disable;
		};

		mdio-pins {
			pins = "gpio39";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie1_pins: pcie1-state {
		clkreq-n-pins {
			pins = "gpio25";
			function = "pcie1_clk";
			drive-strength = <6>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio26";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};

		wake-n-pins {
			pins = "gpio27";
			function = "pcie1_wake";
			drive-strength = <6>;
			bias-pull-up;
		};
	};

	qpic_snand_pins: qpic-snand-state {
		clock-pins {
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio4";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	uart2_pins: uart2-state {
		pins = "gpio34", "gpio35";
		function = "blsp2_uart";
		drive-strength = <8>;
		bias-disable;
	};

	usb_supply_pins: usb-supply-state {
		pins = "gpio64";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-high;
	};
};

&usb3 {
	pinctrl-0 = <&usb_supply_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usb_0_dwc3 {
	dr_mode = "host";
};

&usb_0_qmpphy {
	vdda-pll-supply = <&regulator_usb_phy>;
	vdda-phy-supply = <&regulator_fixed_0p925>;
	status = "okay";
};

&usb_0_qusbphy {
	vdd-supply = <&regulator_fixed_0p925>;
	vdda-pll-supply = <&regulator_usb_phy>;
	vdda-phy-dpdm-supply = <&regulator_fixed_3p3>;
	status = "okay";
};

&wifi0 {
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,ath11k-calibration-variant = "JIDU6J11";
	nvmem-cells = <&base_mac 2>, <&cal_2g>;
	nvmem-cell-names = "mac-address", "calibration";
	status = "okay";
};

&xo_board_clk {
	clock-div = <2>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <48000000>;
};
